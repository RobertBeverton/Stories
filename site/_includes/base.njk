<!doctype html>
<html lang="en" data-base="{{ '/' | url | replace(r/\/$/, '') }}"{% if shell and shell.router === false %} data-router="off"{% endif %}>
<head>
  <meta charset="utf-8">
  {# Pages sends no headers, so the policy is a meta tag; frame-ancestors cannot be set this way. #}
  <meta http-equiv="Content-Security-Policy" content="{{ importMap.csp }}">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }} — Stories</title>
  <meta name="theme-color" content="#1c1a17">
  <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | url }}?v={{ buildTime }}">
  <link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}?v={{ buildTime }}">
  <link rel="stylesheet" href="{{ '/assets/css/dock.css' | url }}?v={{ buildTime }}">
  <link rel="stylesheet" href="{{ '/assets/css/pages.css' | url }}?v={{ buildTime }}">
  <link rel="stylesheet" href="{{ '/assets/css/player.css' | url }}?v={{ buildTime }}">
  <link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/app-icon-192.png' | url }}">
  {# SLOT head-end: meta (noindex, build-id) and CSS links live here #}
  <link rel="stylesheet" href="{{ '/assets/css/lore.css' | url }}?v={{ buildTime }}">
  <meta name="robots" content="noindex">
  <meta name="build-id" content="{{ buildTime }}">
  {# The import map adds ?v=<build> to every module import, so a cached old module can never mix with a new main.js. Its content must stay on one line: the CSP hashes it exactly. #}
  <script type="importmap">{{ importMap.json | safe }}</script>
  <script type="module" src="{{ '/assets/js/main.js' | url }}?v={{ buildTime }}"></script>
</head>
<body>
  {# SLOT view: the only region the router (WP-D) replaces #}
  <main id="view">{{ content | safe }}</main>
  {# The persistent player: ONE <audio>, outside #view, so it survives router swaps.
     On a story page it already holds that story (data-slug and src), which keeps
     story-resume working on a plain page load; the dock module (player.mjs) owns it
     from there. No controls: the dock draws them. #}
  <audio id="player" data-role="shell-audio" preload="{% if audioUrl and slug %}metadata{% else %}none{% endif %}"{% if audioUrl and slug %} data-slug="{{ slug }}" src="{{ audioUrl }}"{% endif %}></audio>
  {# The dock: static nav (Home, Library); the dock module adds the mini-player row and sheet #}
  {% include "dock-static.njk" %}
</body>
</html>
