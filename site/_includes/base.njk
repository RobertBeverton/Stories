<!doctype html>
<html lang="en" data-base="{{ '/' | url | replace(r/\/$/, '') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Stories</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v={{ buildTime }}">
  <link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
  <meta name="theme-color" content="#e8735c">
  <link rel="apple-touch-icon" href="{{ '/assets/app-icon-192.png' | url }}">
  {# SLOT head-end: WP-B adds meta (noindex, build-id, viewport-fit) and CSS links here #}
  <script type="module" src="{{ '/assets/js/main.js' | url }}?v={{ buildTime }}"></script>
</head>
<body>
  {# SLOT view: the only region the router (WP-D) replaces #}
  <main id="view">{{ content | safe }}</main>
  {# SLOT player: persistent <audio id="player"> lands here in WP-D, outside #view #}
  {# SLOT dock: WP-B fills the markup; the nav below is the current placeholder #}
  <nav class="tab-bar" aria-label="Main navigation" data-mount="dock">
    <a href="{{ '/' | url }}" class="tab-bar-item">🏠<span>Home</span></a>
    <a href="{{ '/' | url }}#stories" class="tab-bar-item">📖<span>Library</span></a>
  </nav>
</body>
</html>
