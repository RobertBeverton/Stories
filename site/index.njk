---
layout: base.njk
title: Home
---
<header class="home-head">
  <h1 class="home-title">Stories</h1>
  <p class="home-tagline">Felix and Alex's story worlds</p>
</header>

{# Server-rendered fallback: the newest story. The continue module replaces it
   with the most recent unfinished story. #}
<section class="home-continue" aria-labelledby="continue-heading">
  <h2 id="continue-heading">Up next</h2>
  <div data-mount="continue">
    {% if stories.length > 0 %}
    {% set story = stories[0] %}
    <a class="card-continue" href="{{ story.url }}" data-slug="{{ story.slug }}">
      {% set coverStory = story %}{% set coverClass = '' %}
      {% include "cover.njk" %}
      <div>
        <p class="card-continue-label">Newest story</p>
        <p class="card-continue-title">{{ story.title }}</p>
        <span class="btn btn-primary btn-lg">Open</span>
      </div>
    </a>
    {% endif %}
  </div>
</section>

<section aria-labelledby="lately-heading">
  <h2 id="lately-heading">Played lately</h2>
  <div class="lately-root" data-mount="played-lately"></div>
</section>

<section aria-labelledby="worlds-heading">
  <h2 id="worlds-heading">Choose a world</h2>
  <div class="world-picker" data-mount="world-switcher" data-variant="picker">
    <a class="world-tile btn-lg" href="{{ '/library/' | url }}">All stories</a>
  </div>
</section>
